<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.0" />

    <!-- Auth package -->
    <PackageVersion Include="Azure.Identity" Version="1.16.0" />
    <PackageVersion Include="Azure.Core" Version="1.48.0" />

    <!--
      Compression package (FR-5.3, the closed G2 decision in requirements.md §23 Q2/Q3): pure-.NET,
      no native-asset RID complexity, trim/AOT friendly, MIT-licensed codecs for the spooled
      protocol's json+lz4/json+zstd encodings, isolated in TriQL.Client.Compression per REQ-ARCH-4.
    -->
    <PackageVersion Include="K4os.Compression.LZ4" Version="1.3.8" />
    <PackageVersion Include="ZstdSharp.Port" Version="0.8.8" />

    <!-- Analyzers -->
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.0.0" />

    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Testcontainers" Version="4.14.0" />
    <!-- Phase 7: MinIO Testcontainers module for spooling-validation infrastructure. -->
    <PackageVersion Include="Testcontainers.Minio" Version="4.14.0" />
    <!--
      Phase 7 test-only dependency: talks to MinIO directly (bucket setup, raw-object verification
      bypassing TriQL) so Lane B tests can assert on object-storage state independent of the
      client under test. Confined to TriQL.IntegrationTests; never referenced by shipping src/.
    -->
    <PackageVersion Include="AWSSDK.S3" Version="4.0.103.3" />

    <!-- Benchmarks -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.14.0" />
  </ItemGroup>

</Project>
