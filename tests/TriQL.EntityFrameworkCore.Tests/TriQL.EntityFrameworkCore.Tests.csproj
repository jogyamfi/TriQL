    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TriQL.EntityFrameworkCore\TriQL.EntityFrameworkCore.csproj" />
