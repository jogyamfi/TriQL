<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>TriQL.Client.Auth</PackageId>
    <Title>TriQL Client Authentication Providers</Title>
    <Description>Cloud and enterprise authentication providers (Microsoft Entra ID, OAuth 2.0) for the TriQL .NET client for Trino.</Description>
    <PackageTags>$(CommonPackageTags);auth;oauth;entra-id</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TriQL.Client\TriQL.Client.csproj" />
    <!-- Needed only to reach the internal AuthenticatorRegistry extension point (see AssemblyInfo.cs
         in TriQL.Data.ADO); REQ-ARCH-3 forbids the reverse reference, not this one. -->
    <ProjectReference Include="..\TriQL.Data.ADO\TriQL.Data.ADO.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="ILLink.Descriptors.xml" LogicalName="ILLink.Descriptors.xml" />
  </ItemGroup>

</Project>
