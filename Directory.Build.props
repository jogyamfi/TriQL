<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Authors>TriQL Contributors</Authors>
    <RepositoryUrl>https://github.com/jogyamfi/TriQL</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
  </PropertyGroup>

  <!-- Shipping libraries under src/ are trim- and AOT-compatible, fully documented, and produce a NuGet package. -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Contains('\src\'))">
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!--
      REL-3/REL-4/P6-T15 package metadata. PackageReleaseNotes deliberately points at GitHub
      Releases rather than embedding per-version notes in the .nuspec (kept in one place, updated
      per release without touching every project). PackageIcon is NOT set: NuGet requires a real
      binary image file, which does not exist in this repository yet — `dotnet pack` on any src/
      project will emit NU5046 until a real icon.png is added here and referenced. This is a known
      gap; see docs/implementation-plan.md Phase 6.
    -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>https://github.com/jogyamfi/TriQL/releases</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup Condition="$(MSBuildProjectDirectory.Contains('\src\'))">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- Test, benchmark, and sample projects are not packaged and target net10.0 only. -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Contains('\tests\')) OR $(MSBuildProjectDirectory.Contains('\samples\'))">
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    CA1707 (underscores in identifiers) and CA1711 (type name ends in a reserved suffix) both
    collide with idiomatic xUnit conventions: MethodName_Scenario_Outcome test naming, and the
    "FooCollection" fixture-collection-definition pattern. CA2007 (ConfigureAwait) directly
    conflicts with xUnit1030, which forbids ConfigureAwait(false) in test methods. CA1849 (prefer
    async APIs) directly conflicts with conformance tests for a provider's SYNCHRONOUS ADO.NET
    surface (TEST-9): calling DbCommand.ExecuteReader()/DbDataReader.Read() etc. synchronously is
    the point of those tests, not an oversight. Suppressed for test projects only.
  -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Contains('\tests\'))">
    <NoWarn>$(NoWarn);CA1707;CA1711;CA2007;CA1849</NoWarn>
  </PropertyGroup>

  <!--
    CA2007 (ConfigureAwait) is a library-authoring rule: it protects against deadlocking a
    caller's synchronization context, which is irrelevant to top-level application/demo code that
    owns its own entry point (P6-T10 samples).
  -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Contains('\samples\'))">
    <NoWarn>$(NoWarn);CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="$(MSBuildProjectDirectory.Contains('\src\'))">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
  </ItemGroup>

</Project>
