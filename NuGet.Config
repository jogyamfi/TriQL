<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Central Package Management requires either a single package source or explicit
    package source mapping. This repo is public OSS and only needs nuget.org, so we
    pin to exactly that regardless of any machine-level corporate feed configuration
    (clear + add overrides inherited sources for this solution only).
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
